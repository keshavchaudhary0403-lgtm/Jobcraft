{
  "manifest_version": 3,
  "name": "Jobcraft - Send job",
  "version": "1.4.0",
  "description": "A Jobcraft side panel: send the job you're viewing (LinkedIn, Naukri or any careers page) to your Jobcraft.",
  "action": {
    "default_title": "Open Jobcraft",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://jobcraft-sooty.vercel.app/*",
    "http://localhost:3000/*",
    "https://media.licdn.com/*",
    "https://*.naukimg.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}