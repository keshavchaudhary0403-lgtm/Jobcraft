# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY — never expose. Used for phone login lookup + Admin page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# The AI model is chosen in the app: Admin → AI & spending (default gpt-6.1-terra)

# Demo mode: 1 = sample AI results, no OpenAI calls (for UI testing). 0 = real AI.
AI_DEMO=0

# Claude (Anthropic) - optional second AI provider. Admin picks ChatGPT or Claude in Admin > AI & spending.
ANTHROPIC_API_KEY=
